<resources>
    <!-- Compose draws all UI; this theme only covers the window before Compose's first frame. -->
    <style name="Theme.PuzzleBlockBlast" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pbb_window_background</item>
    </style>

    <style name="Theme.PuzzleBlockBlast.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pbb_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PuzzleBlockBlast</item>
    </style>
</resources>
